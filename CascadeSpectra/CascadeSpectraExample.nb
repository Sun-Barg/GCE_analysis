Cell[TextData[{
 "NB: recall \[Epsilon]=mf/",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "\[Chi]"], TraditionalForm]],ExpressionUUID->
  "4e8ebdf5-03f7-43d2-a949-4469c05858a8"],
 ", so above when we specified \[Epsilon] and subbed in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"mf", "/", "\[Epsilon]"}], TraditionalForm]],ExpressionUUID->
  "716dee1f-2e0f-451b-b66e-2ec7a1951ef7"],
 ", we could equally well have specified ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "\[Chi]"], TraditionalForm]],ExpressionUUID->
  "bfbeef61-8650-42ea-864f-2116b8f90897"],
 " and subbed it in. An example of this is shown below"
}], "Text",
 CellChangeTimes->{{3.656974350305602*^9, 
  3.656974455523155*^9}},ExpressionUUID->"eca7266f-16da-47dc-bece-\
e4460f01b852"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Nu]", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "46469745-09fa-47dc-b8e4-9e0be35ad5ee"],
 " Direct Spectrum of Final State ",
 StyleBox["b",
  FontSlant->"Italic"],
 "-quarks for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Epsilon]", "f"], "=", "0.3"}], TraditionalForm]],
  ExpressionUUID->"6bfc38e5-4042-4c4e-9522-6d79c6d86570"]
}], "Section",
 CellChangeTimes->{{3.6390630204859133`*^9, 3.639063025852809*^9}, {
  3.639076336932643*^9, 3.6390763661398563`*^9}, {3.639076412252461*^9, 
