Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Nu]", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "5b5290d7-3fa3-449e-a6bb-7b70354637ca"],
 " Cascade Spectra of Final State ",
 StyleBox["b",
  FontSlant->"Italic"],
 "-quarks for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Epsilon]", "f"], "=", "0.1"}], TraditionalForm]],
  ExpressionUUID->"78ef26cf-ac80-46c7-871a-689e2c297499"]
}], "Section",
 CellChangeTimes->{{3.6390630204859133`*^9, 3.639063025852809*^9}, {
  3.639076336932643*^9, 3.6390763661398563`*^9}, {3.725895997927475*^9, 
  3.7258960182383738`*^9}, {3.72589615227571*^9, 
  3.72589615252754*^9}},ExpressionUUID->"2b087bd4-a0d5-4b80-b051-\
04c3b5272272"],

Cell[TextData[{
 "In this example we load the numu spectrums of 1-6 step cascade DM \
annihilations terminating in ",
 StyleBox["b",
  FontSlant->"Italic"],
 "-quarks for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Epsilon]", "f"], "=", "0.1"}], TraditionalForm]],
  ExpressionUUID->"06966182-5cdb-484b-be93-d7ea75b70146"],
 ". Note that, as expected, there are more muon neutrinos, because charged \
pions produce two muon neutrinos for every electron neutrino produced."
}], "Text",
 CellChangeTimes->{{3.6445976000873127`*^9, 3.644597637650031*^9}, {
   3.6569740152601748`*^9, 3.6569740215851297`*^9}, 3.6569741348752193`*^9, {
   3.7258960226274014`*^9, 3.725896033581571*^9}, {3.725896206328569*^9, 
   3.7258962401454277`*^9}},ExpressionUUID->"32b45602-0eee-4cac-90e5-\
86f0280f8081"],

