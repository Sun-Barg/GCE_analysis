Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Nu]", "\[Tau]"], TraditionalForm]],ExpressionUUID->
  "c314c097-655b-409a-bc61-6ef8b8cf5d05"],
 " Cascade Spectra of Final State ",
 StyleBox["b",
  FontSlant->"Italic"],
 "-quarks for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Epsilon]", "f"], "=", "0.1"}], TraditionalForm]],
  ExpressionUUID->"1a65391c-44d4-4097-b3b5-eb5752257238"]
}], "Section",
 CellChangeTimes->{{3.6390630204859133`*^9, 3.639063025852809*^9}, {
  3.639076336932643*^9, 3.6390763661398563`*^9}, {3.725895997927475*^9, 
  3.7258960182383738`*^9}, {3.725896159866088*^9, 
  3.7258961607586107`*^9}},ExpressionUUID->"c821a82b-f3ee-45f9-8f13-\
86f404efc518"],

Cell[TextData[{
 "In this example we load the nutau spectrums of 1-6 step cascade DM \
annihilations terminating in ",
 StyleBox["b",
  FontSlant->"Italic"],
 "-quarks for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Epsilon]", "f"], "=", "0.1"}], TraditionalForm]],
  ExpressionUUID->"26c264ed-6f3c-4a1e-ac3e-14f6eaf341c9"],
 ". Here we can see there are far fewer tau neutrino decays, as these require \
a W to appear in the shower in order to appear."
}], "Text",
 CellChangeTimes->{{3.6445976000873127`*^9, 3.644597637650031*^9}, {
   3.6569740152601748`*^9, 3.6569740215851297`*^9}, 3.6569741348752193`*^9, {
